---
import Layout from '@layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { withBasePath } from '@lib/paths';

export async function getStaticPaths() {
  const communities = await getCollection('communities');
  return communities.map((community) => ({
    params: { slug: community.data.slug },
    props: { community },
  }));
}

interface Props {
  community: CollectionEntry<'communities'>;
}

const { community } = Astro.props;
const data = community.data;

// Community libraries are filtered views of the main catalog; there are no
// community-specific dataset records.
const allResources = await getCollection('master-library');
const communityDatasets = allResources.filter((entry) => entry.data.tags.includes(data.slug));

const pageTitle = `Welcome to ${data.name}`;
const pageDescription = data.description || `Community data library for ${data.name}`;
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="community-entry">
    <header class="entry-header">
      <div class="header-badge">
        <span class="state-pill">{data.state_code}</span>
        {data.county && <span class="county-label">{data.county}</span>}
      </div>
      <h1>Welcome to {data.name}</h1>
      {data.description && <p class="intro-desc">{data.description}</p>}

      <div class="meta-grid">
        <div class="meta-card">
          <span class="meta-label">State</span>
          <span class="meta-value">{data.state_code}</span>
        </div>
        {data.county && (
          <div class="meta-card">
            <span class="meta-label">County</span>
            <span class="meta-value">{data.county}</span>
          </div>
        )}
        {data.county_fips && (
          <div class="meta-card">
            <span class="meta-label">County FIPS</span>
            <span class="meta-value font-mono">{data.county_fips}</span>
          </div>
        )}
        {data.zip_codes && data.zip_codes.length > 0 && (
          <div class="meta-card meta-card-wide">
            <span class="meta-label">ZIP Codes</span>
            <span class="meta-value font-mono">{data.zip_codes.join(', ')}</span>
          </div>
        )}
        {data.librarian_email && (
          <div class="meta-card">
            <span class="meta-label">Community Librarian</span>
            <span class="meta-value">
              <a href={`mailto:${data.librarian_email}`}>{data.librarian_email}</a>
            </span>
          </div>
        )}
      </div>
    </header>

    <!--
      ========================================================================
      TODO: Stub role selection (UI only).
      Real role-based access control and content gating will be implemented
      separately using Netlify Identity roles and a Netlify serverless function.
      Decap CMS does not provide runtime role-based content access.
      Do NOT implement client-side fake security.
      ========================================================================
    -->
    <section class="role-selector-section" aria-label="Role selection">
      <div class="role-selector-header">
        <span class="eyebrow">Interactive View</span>
        <h2>Select Your Role</h2>
        <p class="role-instructions">
          Choose a role perspective to preview datasets and materials tailored to that viewpoint.
        </p>
      </div>

      <div class="role-buttons" role="group" aria-label="Role Selection Buttons">
        <button
          type="button"
          class="role-btn active"
          data-role="teacher"
          id="btn-role-teacher"
          aria-pressed="true"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
            <path d="M6 12v5c3 3 9 3 12 0v-5"/>
          </svg>
          Teacher
        </button>

        <button
          type="button"
          class="role-btn"
          data-role="student"
          id="btn-role-student"
          aria-pressed="false"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
          </svg>
          Student
        </button>

        <button
          type="button"
          class="role-btn"
          data-role="community_member"
          id="btn-role-community"
          aria-pressed="false"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          Community Member
        </button>
      </div>

      <div class="role-status-card" id="role-status-panel">
        <div class="status-indicator">
          <span class="status-dot"></span>
          <span>Current active perspective: <strong id="active-role-label">Teacher</strong></span>
        </div>
        <p id="active-role-description" class="status-desc">
          Viewing educator perspective with full access to curriculum resources and pedagogical tags.
        </p>
      </div>
    </section>

    <!-- Datasets List for this Community -->
    <section class="datasets-section" aria-label="Community Datasets">
      <div class="section-title-wrap">
        <h2>Community Datasets</h2>
        <span class="dataset-count">{communityDatasets.length} dataset{communityDatasets.length !== 1 ? 's' : ''} available</span>
      </div>

      {communityDatasets.length > 0 ? (
        <div class="datasets-grid">
          {communityDatasets.map((ds) => (
            <article class="dataset-card">
              <div class="dataset-header">
                <h3>{ds.data.title}</h3>
                {ds.data.url && (
                  <a
                    href={ds.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="source-link"
                  >
                    Source ↗
                  </a>
                )}
              </div>
              <p class="dataset-desc">{ds.data.description}</p>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>No datasets have been added for this community yet.</p>
        </div>
      )}
    </section>
  </section>
</Layout>

<script>
  // UI-only local state management for role selection
  // TODO: Replace with Netlify Identity role authentication & serverless function gating
  const roleDescriptions: Record<string, { label: string; desc: string }> = {
    teacher: {
      label: 'Teacher',
      desc: 'Viewing educator perspective with classroom planning resources and full pedagogical tags.',
    },
    student: {
      label: 'Student',
      desc: 'Viewing student-safe perspective with sensitive datasets and administrative tools filtered.',
    },
    community_member: {
      label: 'Community Member',
      desc: 'Viewing public community member perspective with open local datasets and exploration resources.',
    },
  };

  const buttons = document.querySelectorAll<HTMLButtonElement>('.role-btn');
  const labelEl = document.getElementById('active-role-label');
  const descEl = document.getElementById('active-role-description');

  let currentRole = 'teacher';

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selectedRole = btn.dataset.role;
      if (!selectedRole || !roleDescriptions[selectedRole]) return;

      currentRole = selectedRole;

      buttons.forEach((b) => {
        const isActive = b === btn;
        b.classList.toggle('active', isActive);
        b.setAttribute('aria-pressed', String(isActive));
      });

      if (labelEl) labelEl.textContent = roleDescriptions[currentRole].label;
      if (descEl) descEl.textContent = roleDescriptions[currentRole].desc;
    });
  });
</script>

<style>
  .community-entry {
    display: grid;
    gap: var(--space-12);
  }

  .entry-header {
    display: grid;
    gap: var(--space-4);
    border-bottom: 1.5px solid var(--color-border);
    padding-bottom: var(--space-8);
  }

  .header-badge {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .state-pill {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 700;
    padding: 2px 8px;
    background: var(--color-secondary);
    color: #F8FAFC;
    border-radius: var(--radius-sm);
    letter-spacing: 0.05em;
  }

  .county-label {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .entry-header h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
  }

  .intro-desc {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
    max-width: 65ch;
    margin: 0;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .meta-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    display: grid;
    gap: 2px;
  }

  .meta-card-wide {
    grid-column: span 2;
  }

  @media (max-width: 640px) {
    .meta-card-wide {
      grid-column: span 1;
    }
  }

  .meta-label {
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-dim);
  }

  .meta-value {
    font-size: var(--font-size-sm);
    color: var(--color-text);
    font-weight: 500;
  }

  .meta-value.font-mono {
    font-family: var(--font-mono);
  }

  /* Role selector section */
  .role-selector-section {
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: grid;
    gap: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-secondary);
    display: block;
    margin-bottom: var(--space-1);
  }

  .role-selector-header h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-2xl);
  }

  .role-instructions {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-base);
  }

  .role-buttons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
  }

  .role-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    border: 1.5px solid var(--color-border);
    background: var(--color-surface-raised);
    color: var(--color-text);
    border-radius: var(--radius-lg);
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .role-btn:hover {
    border-color: var(--color-secondary);
    background: var(--color-surface);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .role-btn.active {
    background: var(--color-secondary);
    border-color: var(--color-secondary);
    color: #F8FAFC;
    box-shadow: var(--shadow-glow-secondary);
  }

  .role-status-card {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    display: grid;
    gap: var(--space-2);
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary);
    display: inline-block;
  }

  .status-desc {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
  }

  /* Datasets Section */
  .datasets-section {
    display: grid;
    gap: var(--space-6);
  }

  .section-title-wrap {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .section-title-wrap h2 {
    margin: 0;
    font-size: var(--font-size-2xl);
  }

  .dataset-count {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-dim);
  }

  .datasets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-4);
  }

  .dataset-card {
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-3);
    align-content: start;
    transition: all 0.18s ease;
  }

  .dataset-card:hover {
    border-color: var(--color-secondary);
    box-shadow: var(--shadow-sm);
  }

  .dataset-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .dataset-header h3 {
    margin: 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-tight);
  }

  .source-link {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-secondary);
    text-decoration: none;
    white-space: nowrap;
  }

  .source-link:hover {
    text-decoration: underline;
  }

  .dataset-desc {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
  }

  .audience-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-3);
  }

  .tag-label {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text-dim);
  }

  .tag-chip {
    font-size: var(--font-size-xs);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    font-weight: 500;
    border: 1px solid var(--color-border);
    background: var(--color-surface-raised);
    color: var(--color-text-muted);
  }

  .tag-teacher {
    background: rgba(14, 114, 101, 0.08);
    border-color: rgba(14, 114, 101, 0.3);
    color: var(--color-primary);
  }

  .tag-student {
    background: rgba(21, 94, 117, 0.08);
    border-color: rgba(21, 94, 117, 0.3);
    color: var(--color-secondary);
  }

  .tag-community_member {
    background: rgba(26, 107, 69, 0.08);
    border-color: rgba(26, 107, 69, 0.3);
    color: var(--color-accent);
  }

  .empty-state {
    padding: var(--space-8);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    text-align: center;
    color: var(--color-text-muted);
  }
</style>
